[Unit]
Description=AlephTX 24x7 Rolling 10h15m Public Capture (RWA Equity/Index Cross-Venue Matrix)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aleph-tx
Group=aleph-tx
Nice=10
CPUQuota=35%
Environment="RCLONE_CONFIG=/etc/aleph-tx/rclone.conf"
Environment="ALEPH_PUBLIC_BRONZE_REMOTE="
EnvironmentFile=-/etc/aleph-tx/flywheel.env
WorkingDirectory=/var/lib/aleph-tx-captures/rwa
ExecStart=/usr/bin/python3 /opt/aleph-tx/current/scripts/perp_rolling_runner.py \
  --stream-name rwa \
  --output-dir /var/lib/aleph-tx-captures/rwa \
  --quarantine-dir /var/lib/aleph-tx-captures/quarantine \
  --window-duration 36900s \
  --collector-region tokyo \
  --split-role selection_dev \
  --evict-below-free-gib 16.0 \
  -- \
  -binance BTCUSDT,ETHUSDT \
  -coinbase BTC-USD,ETH-USD \
  -arcus-ws NVDA-USD,SNDK-USD,AAPL-USD,TSLA-USD,MU-USD,SPY-USD,QQQ-USD,HOOD-USD,COIN-USD,MSTR-USD,AMD-USD,MSFT-USD,GOOGL-USD,AMZN-USD,META-USD,PLTR-USD,CRCL-USD,DRAM-USD \
  -arcus-trades \
  -hyperliquid io:NVDA,io:SNDK,io:AAPL,io:CRCL,io:DRAM,io:NBIS,xyz:NVDA,xyz:SNDK,xyz:AAPL,xyz:TSLA,xyz:MU,xyz:SP500,xyz:XYZ100,xyz:HOOD,xyz:COIN,xyz:MSTR,xyz:AMD,xyz:MSFT,xyz:GOOGL,xyz:AMZN,xyz:META,xyz:PLTR,xyz:CRCL,xyz:DRAM \
  -hl-trades \
  -hl-funding-interval 5m \
  -lighter-robinhood 15,32,10,16,31,26,25,23,29,14,12,11,13,34,24 \
  -lighter-robinhood-trades \
  -lighter 110,139,113,112,164,128,129,108,109,122,138,115,116,114,117,111 \
  -lighter-trades \
  -lighter-clock-refresh 4m \
  -idle-read-timeout 5m
Restart=always
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aleph-tx-captures

[Install]
WantedBy=multi-user.target
