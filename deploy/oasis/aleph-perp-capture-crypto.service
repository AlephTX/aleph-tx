[Unit]
Description=AlephTX 24x7 Rolling 10h15m Public Capture (Crypto Core: BTC, ETH, SOL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aleph-tx
Group=aleph-tx
Nice=10
CPUQuota=35%
Environment="RCLONE_CONFIG=/etc/aleph-tx/rclone.conf"
Environment="ALEPH_PUBLIC_BRONZE_REMOTE="
EnvironmentFile=-/etc/aleph-tx/flywheel.env
WorkingDirectory=/var/lib/aleph-tx-captures/crypto
ExecStart=/usr/bin/python3 /opt/aleph-tx/current/scripts/perp_rolling_runner.py \
  --stream-name crypto \
  --output-dir /var/lib/aleph-tx-captures/crypto \
  --quarantine-dir /var/lib/aleph-tx-captures/quarantine \
  --window-duration 36900s \
  --collector-region tokyo \
  --split-role selection_dev \
  --evict-below-free-gib 16.0 \
  -- \
  -binance BTCUSDT,ETHUSDT,SOLUSDT \
  -coinbase BTC-USD,ETH-USD,SOL-USD \
  -lighter-robinhood 0,1,3 \
  -lighter-robinhood-trades \
  -lighter 0,1,2 \
  -lighter-trades \
  -lighter-clock-refresh 4m \
  -hyperliquid BTC,ETH,SOL \
  -hl-fast-book \
  -hl-trades \
  -hl-funding-interval 5m \
  -arcus-ws BTC-USD,ETH-USD,SOL-USD \
  -arcus-trades \
  -extended BTC-USD,ETH-USD,SOL-USD \
  -extended-index
Restart=always
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aleph-tx-captures

[Install]
WantedBy=multi-user.target
